{
  "name": "Intent Router - AI Agents + OpenRouter + Chat",
  "nodes": [
    {
      "id": "node-chat-trigger",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        -1320,
        140
      ],
      "webhookId": "intent-router-chat",
      "parameters": {
        "options": {
          "responseMode": "responseNodes"
        }
      }
    },
    {
      "id": "node-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1080,
        140
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "name": "user_id",
              "type": "string",
              "value": "={{ $json.sessionId || $json.user_id || 'anonymous' }}"
            },
            {
              "name": "chatInput",
              "type": "string",
              "value": "={{ $json.chatInput || $json.message || '' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-router-agent",
      "name": "Router Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        -840,
        140
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an intent classifier.\n\nClassify the user message into one of these intents:\n- billing\n- general\n- support\n- service\n\nReturn ONLY valid JSON in this format:\n{\n  \"intent\": \"billing|general|support|service\",\n  \"confidence\": 0-1\n}\n\nDo not return markdown. Do not add explanations."
        }
      }
    },
    {
      "id": "node-router-model",
      "name": "OpenRouter Chat Model (Router)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        -900,
        360
      ],
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openRouterApi": {
          "id": "credential-id",
          "name": "openRouterApi Credential"
        }
      }
    },
    {
      "id": "node-router-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -720,
        360
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"billing\", \"general\", \"support\", \"service\"]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  },\n  \"required\": [\"intent\", \"confidence\"]\n}"
      }
    },
    {
      "id": "node-router-memory",
      "name": "Simple Memory (Router)",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        -760,
        520
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Normalize Input').item.json.user_id }}",
        "contextWindowLength": 5
      }
    },
    {
      "id": "node-switch-intent",
      "name": "Switch Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -560,
        140
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "billing",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-billing",
                    "leftValue": "={{ $json.output.intent === 'billing' && Number($json.output.confidence) >= 0.6 }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "general",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-general",
                    "leftValue": "={{ ($json.output.intent === 'general' && Number($json.output.confidence) >= 0.6) || Number($json.output.confidence) < 0.6 }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "support",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-support",
                    "leftValue": "={{ $json.output.intent === 'support' && Number($json.output.confidence) >= 0.6 }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "service",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-service",
                    "leftValue": "={{ $json.output.intent === 'service' && Number($json.output.confidence) >= 0.6 }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "node-billing-agent",
      "name": "Billing Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        -220,
        -180
