        "jsonBody": "={{ {\n  model: $env.OPENROUTER_MODEL || 'openai/gpt-4o-mini',\n  temperature: 0.2,\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a technical support expert. Help solve technical issues step by step.'\n    },\n    {\n      role: 'user',\n      content: `User message: ${$json.message}\\n\\nRecent memory: ${JSON.stringify($json.memory?.history || [])}`\n    }\n  ]\n} }}"
      },
      "id": "9",
      "name": "Support Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENROUTER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $env.OPENROUTER_MODEL || 'openai/gpt-4o-mini',\n  temperature: 0.2,\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a customer service agent. Be polite, helpful, and solution-oriented.'\n    },\n    {\n      role: 'user',\n      content: `User message: ${$json.message}\\n\\nRecent memory: ${JSON.stringify($json.memory?.history || [])}`\n    }\n  ]\n} }}"
      },
      "id": "10",
      "name": "Service Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $item(0).$node['Parse Router JSON'].json;\nconst answer = $json.choices?.[0]?.message?.content?.trim() || 'I could not generate an answer right now.';\n\nreturn [\n  {\n    json: {\n      ...base,\n      answer\n    }\n  }\n];"
      },
      "id": "11",
      "name": "Build Final Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = this.getWorkflowStaticData('global');\nif (!store.memoryByUser) {\n  store.memoryByUser = {};\n}\n\nconst userId = $json.user_id || 'anonymous';\nconst prevHistory = Array.isArray($json.memory?.history) ? $json.memory.history : [];\nconst nextHistory = [\n  ...prevHistory,\n  {\n    user: $json.message,\n    assistant: $json.answer,\n    intent: $json.intent,\n    timestamp: new Date().toISOString()\n  }\n].slice(-5);\n\nconst savedMemory = {\n  last_message: $json.message,\n  last_intent: $json.intent,\n  history: nextHistory\n};\n\nstore.memoryByUser[userId] = savedMemory;\n\nreturn [\n  {\n    json: {\n      ...$json,\n      saved_memory: savedMemory\n    }\n  }\n];"
      },
      "id": "12",
      "name": "Save Memory",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        60
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  user_id: $json.user_id,\n  intent: $json.intent,\n  confidence: $json.confidence,\n  answer: $json.answer,\n  memory: $json.saved_memory\n} }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "13",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        780,
        60
      ]
    }
