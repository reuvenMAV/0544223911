    {
      "parameters": {
        "jsCode": "const router = $item(0).$node['AI Agent'].json;\nconst incoming = $item(0).$node['When chat message received'].json;\nconst answer = $json.choices?.[0]?.message?.content?.trim() || 'I could not generate an answer right now.';\nconst confidence = Number(router.output?.confidence ?? 0);\nconst intent = confidence < 0.6 ? 'general' : (router.output?.intent || 'general');\n\nreturn [\n  {\n    json: {\n      user_id: incoming.sessionId || incoming.user_id || 'anonymous',\n      message: incoming.chatInput || incoming.message || '',\n      intent,\n      confidence,\n      answer\n    }\n  }\n];"
      },
      "id": "52cb3dd7-66d6-41d3-8f78-8a2c9ed37dcf",
      "name": "Build Final Answer1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -928
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = this.getWorkflowStaticData('global');\nif (!store.memoryByUser) {\n  store.memoryByUser = {};\n}\n\nconst userId = $json.user_id || 'anonymous';\nconst existing = store.memoryByUser[userId] || {\n  last_message: '',\n  last_intent: 'general',\n  history: []\n};\n\nconst prevHistory = Array.isArray(existing.history) ? existing.history : [];\nconst nextHistory = [\n  ...prevHistory,\n  {\n    user: $json.message,\n    assistant: $json.answer,\n    intent: $json.intent,\n    timestamp: new Date().toISOString()\n  }\n].slice(-5);\n\nconst savedMemory = {\n  last_message: $json.message,\n  last_intent: $json.intent,\n  history: nextHistory\n};\n\nstore.memoryByUser[userId] = savedMemory;\n\nreturn [\n  {\n    json: {\n      ...$json,\n      saved_memory: savedMemory\n    }\n  }\n];"
      },
      "id": "f47fbafb-de7a-4f23-90b2-f931c0a353ac",
