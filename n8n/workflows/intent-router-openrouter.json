        "jsonBody": "={{ {\n  model: $env.OPENROUTER_MODEL || 'openai/gpt-4o-mini',\n  temperature: 0.2,\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a customer service agent. Be polite, helpful, and solution-oriented.'\n    },\n    {\n      role: 'user',\n      content: `User message: ${$item(0).$node[\"When chat message received\"].json.chatInput || ''}`\n    }\n  ]\n} }}",
