# English Coach Web — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# Coach backend: "local" (built-in MVP engine) or "n8n"
COACH_BACKEND=local

# Required when COACH_BACKEND=n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=25000

# Optional Supabase persistence (if empty, progress uses in-memory store for local/dev)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (server-side only — n8n and/or Vercel API routes)
# TELEGRAM_BOT_TOKEN=          # n8n credential or Vercel env — never client-side
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# NEXT_PUBLIC_SITE_URL=https://mora-anglit.vercel.app

# Xiaomi MiMo is configured inside n8n (credential name: Xiaomi MiMo).
# Do NOT put the model API key in this Next.js app.
# Model: mimo-v2.5-pro
# Base URL: https://api.xiaomimimo.com/v1
