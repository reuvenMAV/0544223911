      "parameters": {
        "jsCode": "\nlet rows = $input.all().map(i=>i.json);\nif (rows.length===1 && Array.isArray(rows[0])) rows = rows[0];\nif (rows.length===1 && rows[0] && rows[0].error) rows = [];\nif (!Array.isArray(rows)) rows = [];\n// filter non-booking objects\nrows = rows.filter(r => r && r.guest_name);\nconst chatId = $('Parse Command').item.json.chatId;\nconst text = rows.length\n  ? ('מי בדירה עכשיו:\\n' + rows.map(r => `${r.guest_name} | ${r.phone}\\n${r.checkin} עד ${r.checkout} | ${r.status}`).join('\\n\\n'))\n  : 'הדירה פנויה כרגע (אין הזמנה paid היום)';\nreturn [{ json: { chatId, text, count: rows.length } }];\n"
