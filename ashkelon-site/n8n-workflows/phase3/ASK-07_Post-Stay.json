        "jsCode": "\nconst rows = Array.isArray($json) ? $json : [];\nif (!rows.length) return [];\nreturn rows.map(r => ({\n  json: {\n    chatId: '8503731042',\n    text: `Post-Stay ביקורת\\n${r.guest_name} | ${r.phone}\\nCheckout: ${r.checkout}\\nשלח לינק לביקורת Google (Phase 5 WA)`\n  }\n}));\n"
