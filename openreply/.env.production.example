# Production values for mavash.net — copy into Vercel + Railway.
# Do not put real secrets in git. Generate them with scripts/generate-secrets.sh.

# Public URL (subdomain — the apex mavash.net stays the marketing site)
NEXTAUTH_URL=https://openreply.mavash.net

NEXTAUTH_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
WEBHOOK_VERIFY_TOKEN=

# Railway public URLs on Vercel; internal *.railway.internal on the worker
DATABASE_URL=
REDIS_URL=

# After verifying mavash.net in Resend (keep Google MX as-is)
RESEND_API_KEY=
EMAIL_FROM=OpenReply <noreply@mavash.net>

META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
